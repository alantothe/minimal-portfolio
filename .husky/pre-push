current_branch="$(git branch --show-current)"

if [ "$current_branch" = "main" ]; then
  echo "Blocked: never push directly from main."
  echo "Run: bun run work:start"
  exit 1
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: never push directly to remote main."
    echo "Push a feature branch and merge it through a pull request."
    exit 1
  fi
done

bun run check
