{
  "name": "minimal",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/marked": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "wrangler": "^4.114.0"
  },
  "scripts": {
    "start": "bun run start.ts",
    "dev": "bun --watch index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "help": "bun scripts/help.ts",
    "baseline:check": "bun scripts/baseline.ts check",
    "baseline:capture": "bun scripts/baseline.ts capture",
    "shadow:parity": "bun scripts/shadow-parity.ts",
    "cloudinary:configure": "bun scripts/configure-cloudinary.ts",
    "recovery:status": "bun scripts/recovery.ts status",
    "recovery:checkpoint": "bun scripts/recovery.ts checkpoint manual",
    "recovery:drill": "bun scripts/recovery.ts drill-latest",
    "recovery:fixture-drill": "bun scripts/recovery.ts fixture-drill",
    "cutover:status": "bun scripts/cutover.ts status",
    "cutover:advance": "bun scripts/cutover.ts advance",
    "cutover:rollback": "bun scripts/cutover.ts rollback",
    "cutover:reconcile-views": "bun scripts/cutover.ts reconcile-views",
    "prepare": "if command -v husky >/dev/null 2>&1; then husky; fi",
    "work:start": "bun scripts/workflow.ts start",
    "work:status": "bun scripts/workflow.ts status",
    "work:submit": "bun scripts/workflow.ts submit",
    "work:finish": "bun scripts/workflow.ts finish",
    "work:learn": "bash scripts/workflow-wizard.sh"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1"
  }
}
